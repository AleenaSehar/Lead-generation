generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  DISQUALIFIED
  CONVERTED
  ARCHIVED
}

enum LeadSourceType {
  WEBSITE
  LINKEDIN
  REFERRAL
  CSV_IMPORT
  MANUAL
  API
  OTHER
}

enum LeadActivityType {
  CREATED
  UPDATED
  SCORE_CHANGED
  STATUS_CHANGED
  ASSIGNED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  EMAIL_BOUNCED
  EMAIL_COMPLAINED
  EMAIL_UNSUBSCRIBED
  SUPPRESSION_CHANGED
  CRM_SYNCED
  CRM_SYNC_FAILED
  FORM_SUBMITTED
  MEETING_BOOKED
  NOTE_ADDED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

enum EmailSequenceStatus {
  DRAFT
  ARCHIVED
}

enum SequenceEnrollmentStatus {
  PENDING
  RUNNING
  COMPLETED
  REPLIED
  FAILED
  CANCELLED
}

enum SequenceStepRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
  LEGAL_REQUEST
}

enum MeetingStatus {
  BOOKED
  CANCELLED
}

enum CrmProviderType {
  MOCK
  HUBSPOT
}

enum CrmSyncStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  LEAD_QUALIFIED
  HIGH_SCORE
  EMAIL_REPLIED
  MEETING_BOOKED
  CRM_SYNC_FAILED
}

enum CaptureFormStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ScoringRuleField {
  SOURCE
  STATUS
  JOB_TITLE
  COMPANY_NAME
  COMPANY_DOMAIN
  EMAIL
  PHONE
  CONSENT
}

enum ScoringRuleOperator {
  EQUALS
  CONTAINS
  EXISTS
  NOT_EXISTS
}

model User {
  id               String            @id @default(cuid())
  supabaseUserId   String?           @unique
  email            String            @unique
  name             String?
  imageUrl         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      WorkspaceMember[]
  assignedLeads    Lead[]            @relation("LeadOwner")
  createdCampaigns Campaign[]        @relation("CampaignCreator")
  activities       LeadActivity[]    @relation("ActivityActor")
  createdForms     CaptureForm[]     @relation("CaptureFormCreator")
  createdBookingPages BookingPage[]  @relation("BookingPageCreator")
  crmSyncAttempts CrmSyncAttempt[]    @relation("CrmSyncInitiator")
  notificationReads NotificationRead[]
}

model Workspace {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  members            WorkspaceMember[]
  leads              Lead[]
  activities         LeadActivity[]
  campaigns          Campaign[]
  workflows          Workflow[]
  workflowRuns       WorkflowRun[]
  emailSequences     EmailSequence[]
  emailEvents        EmailEvent[]
  suppressionEntries SuppressionEntry[]
  captureForms       CaptureForm[]
  captureSubmissions CaptureSubmission[]
  scoringRules       ScoringRule[]
  sequenceEnrollments SequenceEnrollment[]
  bookingPages       BookingPage[]
  meetings           Meeting[]
  crmConnection      CrmConnection?
  crmContactLinks    CrmContactLink[]
  crmSyncAttempts    CrmSyncAttempt[]
  notifications      Notification[]
}

model ScoringRule {
  id          String              @id @default(cuid())
  name        String
  field       ScoringRuleField
  operator    ScoringRuleOperator
  value       String?
  points      Int
  isActive    Boolean             @default(true)
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, position])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String
  workspaceId String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Lead {
  id             String         @id @default(cuid())
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  jobTitle       String?
  companyName    String?
  companyDomain  String?
  status         LeadStatus     @default(NEW)
  source         LeadSourceType @default(MANUAL)
  sourceDetails  Json?
  score          Int            @default(0)
  scoreDetails   Json?
  consentAt      DateTime?
  consentSource  String?
  customFields   Json?
  lastActivityAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspaceId    String
  ownerId        String?
  campaignId     String?
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  workflowRuns   WorkflowRun[]
  emailEvents    EmailEvent[]
  captureSubmissions CaptureSubmission[]
  sequenceEnrollments SequenceEnrollment[]
  meetings       Meeting[]
  crmContactLinks CrmContactLink[]
  crmSyncAttempts CrmSyncAttempt[]
  notifications Notification[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, score])
  @@index([workspaceId, createdAt])
  @@index([ownerId])
  @@index([campaignId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  dedupeKey   String           @unique
  metadata    Json?
  createdAt   DateTime         @default(now())
  workspaceId String
  leadId      String?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reads       NotificationRead[]

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  readAt         DateTime     @default(now())
  notificationId String
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model CrmConnection {
  id             String          @id @default(cuid())
  provider       CrmProviderType @default(MOCK)
  displayName    String          @default("Development CRM")
  isActive       Boolean         @default(true)
  fieldMapping   Json
  lastTestedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspaceId    String          @unique
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactLinks   CrmContactLink[]
  syncAttempts   CrmSyncAttempt[]
}

model CrmContactLink {
  id              String        @id @default(cuid())
  externalId      String
  lastSyncedAt    DateTime
  sourceUpdatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspaceId     String
  connectionId    String
  leadId          String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection      CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([connectionId, leadId])
  @@unique([connectionId, externalId])
  @@index([workspaceId, lastSyncedAt])
}

model CrmSyncAttempt {
  id              String        @id @default(cuid())
  status          CrmSyncStatus @default(PENDING)
  idempotencyKey  String        @unique
  operation       String        @default("UPSERT_CONTACT")
  requestPayload  Json
  responsePayload Json?
  error           String?
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  workspaceId     String
  connectionId    String
  leadId          String
  initiatedById   String?
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection      CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  initiatedBy     User?         @relation("CrmSyncInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt])
  @@index([leadId, startedAt])
  @@index([connectionId, status])
}

model BookingPage {
  id               String    @id @default(cuid())
  publicId         String    @unique @default(cuid())
  title            String    @default("Book a meeting")
  description      String?
  durationMinutes  Int       @default(30)
  bufferMinutes    Int       @default(0)
  minimumNoticeHours Int     @default(2)
  maximumAdvanceDays Int     @default(30)
  timeZone         String    @default("UTC")
  availability     Json
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspaceId      String    @unique
  createdById      String?
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User?     @relation("BookingPageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  meetings         Meeting[]

  @@index([createdById])
}

model Meeting {
  id             String        @id @default(cuid())
  status         MeetingStatus @default(BOOKED)
  startAt        DateTime
  endAt          DateTime
  attendeeName   String
  attendeeEmail  String
  attendeeTimeZone String
  notes          String?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspaceId    String
  bookingPageId  String
  leadId         String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookingPage    BookingPage   @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([bookingPageId, startAt])
  @@index([workspaceId, startAt])
  @@index([leadId, startAt])
}

model CaptureForm {
  id                 String            @id @default(cuid())
  publicId           String            @unique @default(cuid())
  name               String
  title              String
  description        String?
  successMessage     String            @default("Thanks! We will be in touch soon.")
  status             CaptureFormStatus @default(ACTIVE)
  collectFirstName   Boolean           @default(true)
  collectLastName    Boolean           @default(true)
  collectCompanyName Boolean           @default(true)
  collectJobTitle    Boolean           @default(false)
  collectCompanyDomain Boolean         @default(false)
  collectPhone       Boolean           @default(false)
  collectMessage     Boolean           @default(true)
  requireConsent     Boolean           @default(true)
  consentText        String            @default("I agree to be contacted about this request.")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspaceId        String
  createdById        String?
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User?             @relation("CaptureFormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions        CaptureSubmission[]

  @@index([workspaceId, status])
  @@index([createdById])
}

model CaptureSubmission {
  id          String      @id @default(cuid())
  submittedAt DateTime    @default(now())
  ipHash      String?
  userAgent   String?
  formId      String
  workspaceId String
  leadId      String?
  form        CaptureForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([formId, submittedAt])
  @@index([formId, ipHash, submittedAt])
  @@index([workspaceId, submittedAt])
  @@index([leadId])
}

model LeadActivity {
  id          String           @id @default(cuid())
  sourceKey   String?          @unique
  type        LeadActivityType
  summary     String
  metadata    Json?
  occurredAt  DateTime         @default(now())
  workspaceId String
  leadId      String
  actorId     String?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor       User?            @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([actorId])
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspaceId String
  createdById String?
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leads       Lead[]
  workflows   Workflow[]

  @@index([workspaceId, status])
  @@index([createdById])
}

model Workflow {
  id              String         @id @default(cuid())
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  triggerType     String
  triggerConfig   Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspaceId     String
  campaignId      String?
  emailSequenceId String?        @unique
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  emailSequence   EmailSequence? @relation(fields: [emailSequenceId], references: [id], onDelete: SetNull)
  runs            WorkflowRun[]

  @@index([workspaceId, status])
  @@index([campaignId])
}

model WorkflowRun {
  id          String            @id @default(cuid())
  status      WorkflowRunStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspaceId String
  workflowId  String
  leadId      String?
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  lead        Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workflowId, createdAt])
  @@index([leadId])
}

model EmailSequence {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      EmailSequenceStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow    Workflow?
  steps       EmailStep[]
  enrollments SequenceEnrollment[]

  @@index([workspaceId, status])
}

model SequenceEnrollment {
  id             String                   @id @default(cuid())
  status         SequenceEnrollmentStatus @default(PENDING)
  idempotencyKey String                   @unique
  nextRunAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  workspaceId    String
  emailSequenceId String
  leadId         String
  enrolledById   String
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailSequence  EmailSequence            @relation(fields: [emailSequenceId], references: [id], onDelete: Restrict)
  lead           Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepRuns       SequenceStepRun[]

  @@index([workspaceId, status, nextRunAt])
  @@index([leadId, createdAt])
  @@index([emailSequenceId, createdAt])
}

model SequenceStepRun {
  id              String                @id @default(cuid())
  position        Int
  subject         String
  body            String
  delayMinutes    Int
  status          SequenceStepRunStatus @default(PENDING)
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  attempts        Int                   @default(0)
  error           String?
  lockToken       String?
  lockedAt        DateTime?
  emailIdempotencyKey String            @unique
  providerMessageId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  enrollmentId    String
  enrollment      SequenceEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, position])
  @@index([status, scheduledAt])
}

model EmailStep {
  id              String        @id @default(cuid())
  position        Int
  subject         String
  body            String
  delayMinutes    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  emailSequenceId String
  emailSequence   EmailSequence @relation(fields: [emailSequenceId], references: [id], onDelete: Cascade)

  @@unique([emailSequenceId, position])
}

model EmailEvent {
  id                String         @id @default(cuid())
  type              EmailEventType
  provider          String         @default("mock")
  providerMessageId String?
  providerEventId   String?        @unique
  idempotencyKey    String?        @unique
  metadata          Json?
  occurredAt        DateTime       @default(now())
  workspaceId       String
  leadId            String?
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([providerMessageId])
  @@index([workspaceId, providerMessageId, occurredAt])
}

model SuppressionEntry {
  id          String            @id @default(cuid())
  email       String
  reason      SuppressionReason
  details     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, reason])
}
