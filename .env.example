DATABASE_URL=postgresql://leadflow:leadflow@localhost:55432/leadflow

# Create a development project at https://supabase.com/dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Development-safe email foundation. Only "mock" is enabled in this phase.
EMAIL_PROVIDER=mock
EMAIL_FROM=LeadFlow Dev <no-reply@leadflow.local>
EMAIL_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
UNSUBSCRIBE_SECRET=replace-with-a-different-32-character-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:5555

# Optional real CRM provider. Create a HubSpot app with contacts read/write scopes.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
HUBSPOT_ACCESS_TOKEN=

# Optional real AI insight provider. Only "mock" is enabled by default.
AI_PROVIDER=mock
# Create a Groq API key at https://console.groq.com. Keep this server-only; never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=
